#!/bin/sh
# Starts the packaged app. The Python inside looks for certificates where the build machine (Ubuntu) keeps them, so
# on other distributions it's pointed at theirs, or the app's downloads would be refused.
HERE=$(dirname "$(readlink -f "$0")")
if [ -z "${SSL_CERT_FILE:-}" ]; then
  for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem /etc/ssl/cert.pem; do
    if [ -r "$f" ]; then SSL_CERT_FILE=$f; export SSL_CERT_FILE; break; fi
  done
fi
exec "$HERE/usr/lib/coldshift-dash/Coldshift Dash" "$@"
